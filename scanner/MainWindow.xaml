                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="105" Canvas.Top="-70" Width="2" Height="2" Fill="#2CC4B5FD">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="510" Duration="0:0:11" RepeatBehavior="Forever" BeginTime="0:0:2.6"/>
