                <Ellipse Canvas.Left="545" Canvas.Top="-35" Width="2" Height="2" Fill="#22FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="475" Duration="0:0:7.8" RepeatBehavior="Forever" BeginTime="0:0:3.4"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="200" Canvas.Top="-45" Width="2" Height="2" Fill="#28FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="485" Duration="0:0:9.2" RepeatBehavior="Forever" BeginTime="0:0:0.6"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="30" Canvas.Top="-80" Width="2" Height="2" Fill="#26FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="580" Duration="0:0:12" RepeatBehavior="Forever" BeginTime="0:0:0.3"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="90" Canvas.Top="-55" Width="3" Height="3" Fill="#32FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="555" Duration="0:0:8.5" RepeatBehavior="Forever" BeginTime="0:0:1.2"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="175" Canvas.Top="-90" Width="2" Height="2" Fill="#24BAE6FD">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="590" Duration="0:0:11" RepeatBehavior="Forever" BeginTime="0:0:2.0"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="265" Canvas.Top="-40" Width="2" Height="2" Fill="#2AFFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="540" Duration="0:0:7.2" RepeatBehavior="Forever" BeginTime="0:0:0.5"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="340" Canvas.Top="-100" Width="3" Height="3" Fill="#2E38BDF8">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="600" Duration="0:0:13" RepeatBehavior="Forever" BeginTime="0:0:3.1"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="395" Canvas.Top="-60" Width="2" Height="2" Fill="#26FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="560" Duration="0:0:9" RepeatBehavior="Forever" BeginTime="0:0:1.6"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="465" Canvas.Top="-85" Width="2" Height="2" Fill="#24FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="585" Duration="0:0:10.5" RepeatBehavior="Forever" BeginTime="0:0:2.4"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="520" Canvas.Top="-45" Width="3" Height="3" Fill="#30FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="545" Duration="0:0:8" RepeatBehavior="Forever" BeginTime="0:0:0.9"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="560" Canvas.Top="-95" Width="2" Height="2" Fill="#227DD3FC">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
