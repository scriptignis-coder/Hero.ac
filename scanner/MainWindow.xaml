<Window x:Class="HeRoShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeRo Shield" Height="440" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="18" Background="#FF0A0C10" BorderBrush="#17FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Window_Drag">
        <Grid>
            <!-- stormy sky: lighter grey clouds up top fading to near-black -->
            <Border CornerRadius="18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF20242B" Offset="0"/>
                        <GradientStop Color="#FF14171C" Offset="0.4"/>
                        <GradientStop Color="#FF0A0C10" Offset="0.75"/>
                        <GradientStop Color="#FF060709" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- soft cloud blobs -->
            <Border CornerRadius="18">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.25,0.12" Center="0.25,0.12" RadiusX="0.55" RadiusY="0.4">
                        <GradientStop Color="#22AEB8C6" Offset="0"/>
                        <GradientStop Color="#000A0C10" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="18">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.78,0.2" Center="0.78,0.2" RadiusX="0.5" RadiusY="0.38">
                        <GradientStop Color="#1AC3CCD8" Offset="0"/>
                        <GradientStop Color="#000A0C10" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- custom staff background (set from the dashboard, fetched by PIN) -->
            <Border CornerRadius="18" ClipToBounds="True">
                <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0"/>
            </Border>
            <!-- darken the custom bg so text stays readable -->
            <Border x:Name="BgScrim" CornerRadius="18" Background="#00000000"/>

            <!-- falling rain streaks (animated) -->
            <Canvas ClipToBounds="True">
                <Canvas.Resources>
                    <Style TargetType="Rectangle">
                        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
                        <Setter Property="RadiusX" Value="1"/>
                        <Setter Property="RadiusY" Value="1"/>
                    </Style>
                </Canvas.Resources>
                <Rectangle Canvas.Left="55"  Canvas.Top="-30" Width="2" Height="18" Fill="#33AEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="500" Duration="0:0:0.7" RepeatBehavior="Forever" BeginTime="0:0:0.0"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="140" Canvas.Top="-60" Width="2" Height="20" Fill="#2EAEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="520" Duration="0:0:0.85" RepeatBehavior="Forever" BeginTime="0:0:0.3"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="215" Canvas.Top="-40" Width="2" Height="16" Fill="#33AEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="500" Duration="0:0:0.65" RepeatBehavior="Forever" BeginTime="0:0:0.15"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="300" Canvas.Top="-70" Width="2" Height="22" Fill="#28AEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="540" Duration="0:0:0.9" RepeatBehavior="Forever" BeginTime="0:0:0.45"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="380" Canvas.Top="-35" Width="2" Height="18" Fill="#33AEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="500" Duration="0:0:0.72" RepeatBehavior="Forever" BeginTime="0:0:0.05"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="455" Canvas.Top="-55" Width="2" Height="20" Fill="#2EAEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="520" Duration="0:0:0.8" RepeatBehavior="Forever" BeginTime="0:0:0.35"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="520" Canvas.Top="-45" Width="2" Height="17" Fill="#33AEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="500" Duration="0:0:0.68" RepeatBehavior="Forever" BeginTime="0:0:0.22"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="595" Canvas.Top="-65" Width="2" Height="21" Fill="#28AEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="540" Duration="0:0:0.88" RepeatBehavior="Forever" BeginTime="0:0:0.5"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="95"  Canvas.Top="-50" Width="2" Height="19" Fill="#2EAEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="510" Duration="0:0:0.78" RepeatBehavior="Forever" BeginTime="0:0:0.4"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="250" Canvas.Top="-30" Width="2" Height="16" Fill="#33AEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="500" Duration="0:0:0.66" RepeatBehavior="Forever" BeginTime="0:0:0.12"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="340" Canvas.Top="-58" Width="2" Height="20" Fill="#2EAEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="520" Duration="0:0:0.82" RepeatBehavior="Forever" BeginTime="0:0:0.28"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
                <Rectangle Canvas.Left="420" Canvas.Top="-42" Width="2" Height="18" Fill="#33AEC4E0">
                    <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)" From="0" To="500" Duration="0:0:0.7" RepeatBehavior="Forever" BeginTime="0:0:0.18"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers></Rectangle>
            </Canvas>

            <!-- falling snow dots (animated) -->
            <Canvas ClipToBounds="True">
                <Canvas.Resources>
                    <Style TargetType="Ellipse">
                        <Setter Property="RenderTransform">
                            <Setter.Value><TranslateTransform Y="0"/></Setter.Value>
                        </Setter>
                    </Style>
                </Canvas.Resources>
                <Ellipse Canvas.Left="60"  Canvas.Top="-10" Width="3" Height="3" Fill="#3AFFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="460" Duration="0:0:7"  RepeatBehavior="Forever" BeginTime="0:0:0"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="150" Canvas.Top="-40" Width="2" Height="2" Fill="#28FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="490" Duration="0:0:9"  RepeatBehavior="Forever" BeginTime="0:0:1.5"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="235" Canvas.Top="-20" Width="2" Height="2" Fill="#30C4B5FD">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="470" Duration="0:0:6"  RepeatBehavior="Forever" BeginTime="0:0:0.8"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="320" Canvas.Top="-60" Width="3" Height="3" Fill="#3338BDF8">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="500" Duration="0:0:10" RepeatBehavior="Forever" BeginTime="0:0:2.2"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="410" Canvas.Top="-15" Width="2" Height="2" Fill="#2AFFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
