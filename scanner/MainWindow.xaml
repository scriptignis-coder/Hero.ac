                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="620" Canvas.Top="-50" Width="2" Height="2" Fill="#26FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="550" Duration="0:0:9.5" RepeatBehavior="Forever" BeginTime="0:0:0.2"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="130" Canvas.Top="-100" Width="2" Height="2" Fill="#2038BDF8">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="600" Duration="0:0:14" RepeatBehavior="Forever" BeginTime="0:0:2.8"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="300" Canvas.Top="-55" Width="2" Height="2" Fill="#28FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="555" Duration="0:0:8.8" RepeatBehavior="Forever" BeginTime="0:0:1.1"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="430" Canvas.Top="-35" Width="2" Height="2" Fill="#24FFFFFF">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="535" Duration="0:0:7.6" RepeatBehavior="Forever" BeginTime="0:0:0.7"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                <Ellipse Canvas.Left="500" Canvas.Top="-70" Width="3" Height="3" Fill="#2CBAE6FD">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.Y)" From="0" To="570" Duration="0:0:11.5" RepeatBehavior="Forever" BeginTime="0:0:3.3"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
            </Canvas>

            <!-- top-left wordmark -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16,0,0">
                <!-- magnifying-glass logo -->
                <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Canvas.Effect><DropShadowEffect Color="#FF7DD3FC" BlurRadius="12" ShadowDepth="0"/></Canvas.Effect>
                        <Ellipse Canvas.Left="12" Canvas.Top="10" Width="30" Height="30" Stroke="#FFEFF6FF" StrokeThickness="6"/>
                        <Line X1="38" Y1="36" X2="54" Y2="52" Stroke="#FFEFF6FF" StrokeThickness="6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="HeRo Shield" Foreground="#FFE6EEFC" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="PC-CHECKER" Foreground="#FF6FB7E8" FontSize="9" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <!-- close -->
            <Button x:Name="CloseBtn" Content="✕" Click="Close_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0"
                    Width="28" Height="28" Foreground="#FF7A7190" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" FontSize="14"/>

            <!-- ===== center: progress ring (driven by the real scan %) ===== -->
            <Grid x:Name="Spinner" Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- pulsing outer glow -->
                <Ellipse Width="150" Height="150" Stroke="#2238BDF8" StrokeThickness="20">
                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="0.7" Duration="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
                </Ellipse>
                <!-- faint full track -->
                <Ellipse Width="116" Height="116" Stroke="#14FFFFFF" StrokeThickness="7"/>
                <!-- kept for code-behind (no-op now that the ring spins) -->
                <Path x:Name="ProgressArc" Visibility="Collapsed"/>
                <!-- napse-style spinner: two counter-rotating blue arcs -->
                <Path RenderTransformOrigin="0.5,0.5" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M60,14 A46,46 0 1 1 20.2,37" Width="120" Height="120" Stretch="None">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF7DD3FC" Offset="0"/>
                            <GradientStop Color="#FF0EA5E9" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                    <Path.RenderTransform><RotateTransform x:Name="Rot1" Angle="0"/></Path.RenderTransform>
                    <Path.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Rot1" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Path.Triggers>
                </Path>
                <Path RenderTransformOrigin="0.5,0.5" StrokeThickness="4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M60,30 A30,30 0 1 1 40.7,83" Width="120" Height="120" Stretch="None">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF38BDF8" Offset="0"/>
                            <GradientStop Color="#FFBAE6FD" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                    <Path.RenderTransform><RotateTransform x:Name="Rot2" Angle="0"/></Path.RenderTransform>
                    <Path.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Rot2" Storyboard.TargetProperty="Angle" From="0" To="-360" Duration="0:0:2.2" RepeatBehavior="Forever"/>
                    </Storyboard></BeginStoryboard></EventTrigger></Path.Triggers>
                </Path>
                <!-- center: percentage only -->
                <TextBlock x:Name="PctText" Text="0%" Foreground="#FFEFF6FF" FontSize="40" FontWeight="Bold"
                           FontFamily="{StaticResource Mono}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <!-- ===== bottom status row + progress ===== -->
            <Grid VerticalAlignment="Bottom" Margin="22,0,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FF38BDF8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Waiting for consent…" Margin="9,0,0,0"
                                   Foreground="#FF9A8FB5" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ElapsedText" Text="" Margin="10,0,0,0"
                                   Foreground="#FF6A6186" FontSize="11.5" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- progress bar -->
                <Border Grid.Row="2" Height="5" CornerRadius="3" Background="#12FFFFFF">
                    <Border x:Name="ProgressFill" Height="5" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0EA5E9" Offset="0"/>
                                <GradientStop Color="#FF7DD3FC" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
            </Grid>

            <!-- RESULTS (kept for code-behind; unused) -->
            <Border x:Name="ResultsPanel" Visibility="Collapsed" Background="#FF08070D" CornerRadius="18" Margin="0,0,0,26">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18">
                    <StackPanel>
                        <Border x:Name="VerdictBox" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                            <TextBlock x:Name="VerdictText" HorizontalAlignment="Center" FontFamily="{StaticResource Mono}"
                                       FontWeight="Bold" FontSize="16"/>
                        </Border>
                        <TextBlock x:Name="ResultsText" Foreground="{StaticResource Fg}" FontFamily="{StaticResource Mono}"
                                   FontSize="12.5" TextWrapping="Wrap" LineHeight="20"/>
                        <Button x:Name="CloseResults" Content="Close" Click="Close_Click" Margin="0,18,0,0" Height="36"
                                Foreground="#FF0B0712" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF7DD3FC" Offset="0"/><GradientStop Color="#FF0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- toast -->
            <Border x:Name="Toast" Background="#FF140E22" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    CornerRadius="10" Padding="12,9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,16,44" MaxWidth="240" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="7" Background="#24FF5277">
                        <TextBlock Text="!" Foreground="{StaticResource Bad}" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitle" Text="Detection" Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock x:Name="ToastSub" Text="" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- consent overlay -->
            <Border x:Name="Consent" Background="#E008070D" CornerRadius="18">
                <Border Background="#FF0E0B18" BorderBrush="#2A38BDF8" BorderThickness="1"
                        CornerRadius="14" Padding="24" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <Viewbox Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <Canvas Width="64" Height="64">
                                <Canvas.Effect><DropShadowEffect Color="#FF7DD3FC" BlurRadius="12" ShadowDepth="0"/></Canvas.Effect>
                                <Ellipse Canvas.Left="12" Canvas.Top="10" Width="30" Height="30" Stroke="#FFEFF6FF" StrokeThickness="6"/>
                                <Line X1="38" Y1="36" X2="54" Y2="52" Stroke="#FFEFF6FF" StrokeThickness="6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="PC Verification" Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="19"/>
                        <TextBlock Text="HeRo Shield · read-only check" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,14"/>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="A read-only check of running programs, standard Windows execution logs, your drives, game folder and recycle bin. It takes one screenshot for staff and opens a page to connect your Discord. It never changes files, reads personal documents or messages, or installs anything. You may record your own screen the whole time."/>
                        <StackPanel x:Name="PinRow" Margin="0,0,0,16">
                            <TextBlock x:Name="PinLabel" Text="SCAN PIN (given by staff)" Foreground="{StaticResource Faint}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="PinInput" Height="38" Background="#FF0E1A2E" Foreground="{StaticResource Fg}"
                                     BorderBrush="#3338BDF8" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource Mono}" FontSize="15" CharacterCasing="Upper"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Deny" Click="Deny_Click" Height="40"
                                    Background="Transparent" Foreground="{StaticResource Muted}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button x:Name="AcceptBtn" Grid.Column="2" Content="Accept &amp; start" Click="Accept_Click" Height="40"
                                    Foreground="#FF0B0712" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF7DD3FC" Offset="0"/>
                                        <GradientStop Color="#FF0EA5E9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
