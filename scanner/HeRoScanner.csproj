<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is built into Windows 10 and 11: nothing to install for the player,
         and the .exe is ~1-2 MB (like napse) instead of ~60 MB with the whole .NET 8 runtime inside. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HeRoShieldScanner</AssemblyName>
    <RootNamespace>HeRoShield</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- run as a 64-bit process on 64-bit Windows (so registry / System32 are not redirected) -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- the player only downloads the .exe: no .config file needed -->
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <NoWarn>$(NoWarn);CS8632;CS0436</NoWarn>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>hero-icon.ico</ApplicationIcon>

    <Version>4.5.2</Version>
    <Company>HeRo Shield</Company>
    <Product>HeRo Scanner</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF window icon must be embedded as a WPF Resource, not only as the Win32 application icon. -->
    <Resource Include="hero-icon.ico" />
  </ItemGroup>

  <!-- Everything below is part of Windows' own .NET Framework: no NuGet packages, no DLLs to ship. -->
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- baked into the exe so a lone download has the starter list, AND copied
         beside the exe so the operator can edit it without rebuilding -->
    <EmbeddedResource Include="signatures.json" />
    <None Update="signatures.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
