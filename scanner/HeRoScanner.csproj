<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HeRoShieldScanner</AssemblyName>
    <RootNamespace>HeRoShield</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- ONE self-contained .exe the client just downloads and runs (no DLLs, no .NET).
         The bundle step needs the Avast/Defender exclusion on this folder (already set). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>hero-icon.ico</ApplicationIcon>

    <Version>4.1.0</Version>
    <Company>HeRo Shield</Company>
    <Product>HeRo Scanner</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF window icon must be embedded as a WPF Resource, not only as the Win32 application icon. -->
    <Resource Include="hero-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- baked into the exe so a lone download has the starter list, AND copied
         beside the exe so the operator can edit it without rebuilding -->
    <EmbeddedResource Include="signatures.json" />
    <None Update="signatures.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
